# ===========================================================================
#  Plataforma de Gestion Clinica — plantilla de variables de entorno
# ===========================================================================
#  Copia este archivo a `.env` y complete los valores.
#
#  REGLAS:
#   1. `.env` esta en .gitignore y NUNCA debe versionarse.
#   2. Este archivo NO contiene ningun valor real: solo marcadores.
#   3. En staging y produccion los valores provienen de un gestor de secretos
#      (GitHub Encrypted Secrets, Vault, AWS/GCP Secret Manager), no de archivos.
#   4. Los valores marcados OBLIGATORIO hacen fallar el arranque si faltan.
#   5. Los valores marcados SANDBOX permiten operar sin credenciales reales
#      usando adaptadores simulados; el sistema registra que esta en modo
#      simulado y jamas afirma haber contactado al proveedor real.
# ===========================================================================

# ---------------------------------------------------------------------------
# Entorno de ejecucion
# ---------------------------------------------------------------------------
# local | desarrollo | preproduccion | produccion
ENTORNO=local
DEPURACION=true
# Nivel de log: DEBUG | INFO | WARNING | ERROR
NIVEL_LOG=INFO
# Zona horaria por defecto de la clinica (configurable por clinica en la BD)
ZONA_HORARIA_POR_DEFECTO=America/Guayaquil
# Idioma por defecto de mensajes al usuario
IDIOMA_POR_DEFECTO=es

# ---------------------------------------------------------------------------
# Base de datos PostgreSQL (con extension pgvector)   OBLIGATORIO
# ---------------------------------------------------------------------------
# Se usa 127.0.0.1 y NO 'localhost' a proposito.  En Windows, 'localhost'
# resuelve primero a ::1 (IPv6), el contenedor publica tambien en [::]:5432
# y el reenvio IPv6 de WSL2 no lo relaya: la conexion se queda colgada en
# lugar de fallar, lo que produce arranques que no terminan nunca.
POSTGRES_HOST=127.0.0.1
POSTGRES_PUERTO=5432
POSTGRES_BD=clinica
POSTGRES_USUARIO=clinica
POSTGRES_CONTRASENA=<generar-contrasena-fuerte>
# Se construye a partir de las anteriores si se deja vacio
BD_URL=
# Pool de conexiones
BD_POOL_TAMANO=10
BD_POOL_DESBORDE=20
# Base de datos separada solo para pruebas de integracion
POSTGRES_BD_PRUEBAS=clinica_pruebas

# ---------------------------------------------------------------------------
# Redis (planificador de tareas y limitacion de tasa)   OBLIGATORIO
# ---------------------------------------------------------------------------
# Mismo motivo que en POSTGRES_HOST: IPv4 explicito.
REDIS_HOST=127.0.0.1
REDIS_PUERTO=6379
REDIS_BD=0
REDIS_CONTRASENA=
REDIS_URL=

# ---------------------------------------------------------------------------
# Seguridad y sesiones   OBLIGATORIO
# ---------------------------------------------------------------------------
# Clave de firma de tokens. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
CLAVE_SECRETA=<generar-con-secrets.token_urlsafe(64)>
ALGORITMO_JWT=HS256
# Vida del token de acceso, en minutos (corto a proposito)
MINUTOS_TOKEN_ACCESO=15
# Vida del token de refresco, en dias
DIAS_TOKEN_REFRESCO=7
# Clave de cifrado simetrico para tokens de terceros almacenados (OAuth de
# calendario, etc). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_CIFRADO_DATOS=<generar-con-Fernet.generate_key()>
# Bloqueo por intentos fallidos de inicio de sesion
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15
# Roles que exigen segundo factor obligatorio (separados por coma)
ROLES_CON_2FA_OBLIGATORIO=superadministrador,administrador_clinica,auditor
# Origenes permitidos para CORS (separados por coma, sin comodines en produccion)
ORIGENES_CORS=http://localhost:4200
# Limitacion de tasa global: peticiones por minuto por IP
LIMITE_PETICIONES_POR_MINUTO=120
# Limitacion de tasa de inicio de sesion: intentos por minuto por IP
LIMITE_LOGIN_POR_MINUTO=10

# ---------------------------------------------------------------------------
# Proveedor de LLM   (ADR-0007)
# ---------------------------------------------------------------------------
# anthropic | mock.  `ollama` esta declarado pero no implementado: la fabrica
# falla al arrancar en lugar de caer en silencio al proveedor simulado.
PROVEEDOR_LLM=mock
# Solo se lee del entorno. Nunca se escribe en codigo ni en este archivo.
ANTHROPIC_API_KEY=
MODELO_LLM=claude-sonnet-5
LLM_MAX_TOKENS=2048
# No se envia a los modelos actuales: rechazan los parametros de muestreo con
# el razonamiento activo. Se conserva para un proveedor local futuro.
LLM_TEMPERATURA=0.2
# Profundidad de razonamiento: low | medium | high | xhigh | max
LLM_ESFUERZO=low
# Tiempo maximo de espera del proveedor, en segundos
LLM_TIMEOUT_SEGUNDOS=30
# Base de Ollama si PROVEEDOR_LLM=ollama
OLLAMA_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Proveedor de embeddings   (ADR-0007: local, offline, sin credencial)
# ---------------------------------------------------------------------------
# fastembed | ollama | mock
PROVEEDOR_EMBEDDINGS=fastembed
MODELO_EMBEDDINGS=intfloat/multilingual-e5-small
# Debe coincidir con la dimension declarada en la migracion de pgvector
DIMENSION_EMBEDDINGS=384
# Cache de modelos ONNX (fuera de C: por restriccion de disco, ver ADR-0003)
RUTA_CACHE_EMBEDDINGS=D:/cache/fastembed

# ---------------------------------------------------------------------------
# RAG y base de conocimiento
# ---------------------------------------------------------------------------
RAG_TOP_K=8
RAG_TOP_K_CANDIDATOS=40
# Umbral minimo de similitud para considerar una fuente utilizable
RAG_UMBRAL_SIMILITUD=0.35
# Peso de la busqueda vectorial frente a la textual en la fusion RRF (0..1)
RAG_PESO_VECTORIAL=0.6
RAG_TAMANO_FRAGMENTO=900
RAG_SOLAPE_FRAGMENTO=150
# Si no hay fuente aprobada y vigente, el agente responde que no tiene
# informacion aprobada y ofrece derivar a un humano. No se desactiva.
RAG_EXIGIR_FUENTE=true

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API   SANDBOX
# ---------------------------------------------------------------------------
# cloud_api | sandbox
MODO_WHATSAPP=sandbox
WHATSAPP_ID_NUMERO_TELEFONO=
WHATSAPP_ID_CUENTA_NEGOCIO=
WHATSAPP_TOKEN_ACCESO=
# Cadena arbitraria que se elige al configurar el webhook en Meta
WHATSAPP_TOKEN_VERIFICACION=<cadena-elegida-al-configurar-el-webhook>
# Secreto de la app de Meta, usado para validar la firma X-Hub-Signature-256
WHATSAPP_SECRETO_APP=
WHATSAPP_VERSION_API=v21.0
# Rechazar webhooks sin firma valida. NO poner en false fuera de pruebas.
WHATSAPP_VALIDAR_FIRMA=true

# ---------------------------------------------------------------------------
# Google Calendar (OAuth por profesional)   SANDBOX
# ---------------------------------------------------------------------------
# google | sandbox
MODO_CALENDARIO=sandbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendario/oauth/callback
# Alcance minimo necesario. No ampliar sin revisar la politica de privacidad.
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.events

# ---------------------------------------------------------------------------
# Correo saliente (verificacion de cuenta, recuperacion de contrasena)
# ---------------------------------------------------------------------------
# smtp | consola | mock
MODO_CORREO=consola
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_TLS=true
CORREO_REMITENTE=no-responder@example.invalid
NOMBRE_REMITENTE=Clinica

# ---------------------------------------------------------------------------
# Tareas en segundo plano y outbox transaccional   (ADR-0008)
# ---------------------------------------------------------------------------
WORKER_CONCURRENCIA=4
# Intervalo de barrido del outbox, en segundos
OUTBOX_INTERVALO_SEGUNDOS=10
OUTBOX_MAX_INTENTOS=6
# Retroceso exponencial base, en segundos
OUTBOX_RETROCESO_BASE_SEGUNDOS=30
# Expiracion de un bloqueo temporal de turno (estado HELD), en minutos
MINUTOS_EXPIRACION_HELD=10
# Tiempo limite para aceptar una oferta de lista de espera, en minutos
MINUTOS_EXPIRACION_OFERTA=30

# ---------------------------------------------------------------------------
# Recordatorios (valores por defecto; cada clinica los ajusta en la BD)
# ---------------------------------------------------------------------------
RECORDATORIO_HORAS_ANTES_1=24
RECORDATORIO_HORAS_ANTES_2=3
# Hora local de envio del resumen diario al profesional
HORA_RESUMEN_DIARIO=07:00
# No incluir diagnosticos ni datos clinicos en notificaciones. No desactivar.
NOTIFICACIONES_SIN_DATOS_CLINICOS=true

# ---------------------------------------------------------------------------
# Archivos adjuntos y documentos
# ---------------------------------------------------------------------------
# local | s3
ALMACENAMIENTO_ARCHIVOS=local
RUTA_ALMACENAMIENTO_LOCAL=./almacenamiento
MAX_TAMANO_ARCHIVO_MB=20
TIPOS_ARCHIVO_PERMITIDOS=application/pdf,image/png,image/jpeg,image/webp
# Antivirus opcional (clamd). Si no esta disponible, la carga se rechaza en
# produccion y se registra la limitacion en desarrollo.
ANTIVIRUS_HABILITADO=false
CLAMAV_HOST=localhost
CLAMAV_PUERTO=3310

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
METRICAS_HABILITADAS=true
RUTA_METRICAS=/metrics
# Formato de log: json en todo entorno distinto de local
FORMATO_LOG=json
# Redaccion obligatoria de datos personales y clinicos en los logs
REDACTAR_DATOS_SENSIBLES=true
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Frontend (se inyectan en tiempo de construccion)
# ---------------------------------------------------------------------------
API_URL=http://localhost:8000
# true = el frontend usa datos sinteticos en memoria (Fase 1)
FRONTEND_MODO_SIMULADO=true
