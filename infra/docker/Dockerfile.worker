# ---------------------------------------------------------------------------
#  Imagen del worker de trabajos en segundo plano.
#
#  Comparte etapa de construccion con el backend a proposito: el worker
#  ejecuta la MISMA logica de negocio, solo con otro punto de entrada. Dos
#  arboles de dependencias distintos abririan la puerta a que el worker
#  cancelara bloqueos con una version del servicio de agenda distinta a la
#  que usa la API.
# ---------------------------------------------------------------------------

FROM python:3.11-slim-bookworm AS construccion

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev


FROM python:3.11-slim-bookworm AS ejecucion

RUN apt-get update \
    && apt-get install --no-install-recommends -y tzdata \
    # El worker usa solo el virtualenv de la aplicacion; setuptools del
    # Python global no se necesita y arrastraba copias vulnerables vendorizadas.
    && rm -rf /usr/local/lib/python3.11/site-packages/setuptools \
              /usr/local/lib/python3.11/site-packages/setuptools-*.dist-info \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 clinica \
    && useradd --system --uid 1001 --gid clinica --create-home clinica

WORKDIR /app

COPY --from=construccion --chown=clinica:clinica /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=UTC

USER clinica

# Sin `HEALTHCHECK` con `curl`: el worker no escucha en ningun puerto. Su
# salud se observa por los eventos que emite (`agenda.bloqueos_expirados`) y
# por la antiguedad de la fila mas vieja pendiente en el outbox, que es la
# senal que de verdad importa: un worker en pie que no procesa nada es peor
# que uno caido, porque no dispara ninguna alarma de proceso.
#
# La comprobacion vive en la monitorizacion, no aqui. Ver docs/monitoring.md.

CMD ["arq", "app.tareas.worker.ConfiguracionWorker"]
